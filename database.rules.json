{
  "rules": {
    "authorizedUsers": {
      ".read": "auth != null",
      ".write": false
    },
    "tournaments": {
      "$tournamentId": {
        ".read": true,
        "meta": {
          ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true && newData.exists()"
        },
        "stage1Scores": {
          "$matchCode": {
            ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true && newData.exists()",
            ".validate": "newData.hasChildren(['s1', 's2', 'revision']) && (newData.child('s1').val() === null || newData.child('s1').isNumber()) && (newData.child('s2').val() === null || newData.child('s2').isNumber()) && newData.child('revision').isNumber() && ((!data.exists() && (newData.child('revision').val() === 1 || newData.child('revision').val() === 0)) || (data.exists() && (newData.child('revision').val() === 0 || newData.child('revision').val() === data.child('revision').val() + 1)))"
          }
        },
        "stage1Lock": {
          ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true && newData.exists()",
          ".validate": "newData.hasChildren(['locked']) && newData.child('locked').isBoolean() && (newData.child('locked').val() === false || (newData.child('locked').val() === true && newData.hasChildren(['locked', 'lockedAt', 'officialStage1Rankings', 'officialFinalsPools'])))"
        },
        "finalsScores": {
          "$pool": {
            ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true && newData.exists()",
            "$matchIdx": {
              ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true && newData.exists()",
              ".validate": "newData.hasChildren(['s1', 's2', 'revision']) && (newData.child('s1').val() === null || newData.child('s1').isNumber()) && (newData.child('s2').val() === null || newData.child('s2').isNumber()) && newData.child('revision').isNumber() && ((!data.exists() && (newData.child('revision').val() === 1 || newData.child('revision').val() === 0)) || (data.exists() && (newData.child('revision').val() === 0 || newData.child('revision').val() === data.child('revision').val() + 1)))"
            }
          }
        },
        "finalsPlayoffs": {
          ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true"
        },
        "scoreActivityLog": {
          "$pushId": {
            ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['action', 'serverTimestamp', 'enteredBy'])"
          }
        }
      }
    },
    "seasons": {
      "$seasonId": {
        ".read": true,
        "config": {
          ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true"
        },
        "players": {
          "$playerId": {
            ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true && newData.exists()",
            ".validate": "newData.hasChildren(['id', 'name', 'normalizedName', 'active', 'createdByUid']) && newData.child('id').val() === $playerId && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('normalizedName').isString() && newData.child('active').isBoolean()"
          }
        },
        "matches": {
          ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true"
        },
        "audit": {
          "$pushId": {
            ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true && !data.exists() && newData.exists()"
          }
        },
        "computed": {
          ".write": "auth != null && root.child('authorizedUsers').child(auth.uid).val() === true"
        }
      }
    }
  }
}
